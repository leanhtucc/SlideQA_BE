NODE_ENV=development
PORT=3000

# --- Cục bộ (docker compose up -d hoặc Postgres tự cài) ---
DATABASE_URL="postgresql://slideqa_user:slideqa_pass@localhost:5432/slideqa_db"
DIRECT_URL="postgresql://slideqa_user:slideqa_pass@localhost:5432/slideqa_db"

# --- Supabase (xem README): thay hai dòng trên bằng
# DATABASE_URL = Connection pooling, chế độ Transaction (cổng 6543), thêm ?pgbouncer=true&connection_limit=1
# DIRECT_URL   = Direct connection (cổng 5432) hoặc Session pooler, dùng cho prisma migrate

# Bí mật ký access token, tối thiểu 32 ký tự. Tạo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Số lớp proxy phía trước API (0 nếu chạy trực tiếp). Đặt đúng khi deploy để rate limit lấy được IP thật.
TRUST_PROXY=0

# Nhiều origin cách nhau bằng dấu phẩy
CORS_ORIGIN=http://localhost:5173
# Để trống = không có AI: hỏi đáp chạy chế độ extractive, quiz tắt. Không bao giờ commit khóa thật.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# mock = trợ lý giả, không gọi mạng, để phát triển web mà không cần khóa. Mặc định: anthropic
LLM_PROVIDER=anthropic

# Địa chỉ web, dùng dựng liên kết đặt lại mật khẩu trong email (hiện thư chỉ ghi ra console)
WEB_URL=http://localhost:5173
GOOGLE_CLIENT_ID=